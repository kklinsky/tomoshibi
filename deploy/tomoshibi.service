[Unit]
Description=Tomoshibi voice companion
After=local-fs.target sound.target
# A power cut can mean many restarts in a row; never give up.
StartLimitIntervalSec=0

[Service]
User=tomoshibi
Group=tomoshibi
WorkingDirectory=/var/lib/tomoshibi
Environment=HOME=/var/lib/tomoshibi
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/tomoshibi chat
StandardInput=null
# Setup mode serves its page on port 80 of the setup hotspot, so phones open it as a captive
# portal (docs/DESIGN.md §10b). This lets Tomo use that one low port; it's still not root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5
# Exit code 2 means setup is wrong (e.g. no API key); restarting won't fix that.
RestartPreventExitStatus=2
# SIGINT lets Tomo turn the screen and button light off on the way out.
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
